<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/kb_ripple_dark">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/kb_key_dark" />
        </shape>
    </item>

    <item>
        <layer-list>
            <!-- Soft bottom shadow bevel -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/kb_key_shadow_dark" />
                </shape>
            </item>
            <!-- Key face -->
            <item android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/kb_key_dark" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
