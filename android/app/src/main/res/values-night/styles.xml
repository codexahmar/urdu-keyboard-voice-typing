<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- =====================================================================
         App / Window themes (dark)
         ===================================================================== -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Dark-mode overrides: swap drawables and colors, keep all layout attrs same -->
    <style name="KeyboardButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2.5dp</item>
        <item name="android:background">@drawable/key_background_dark</item>
        <item name="android:textColor">@color/kb_text_primary_dark</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KeyboardButtonFunctional" parent="KeyboardButton">
        <item name="android:background">@drawable/key_background_functional_dark</item>
        <item name="android:textColor">@color/kb_text_functional_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="KeyboardButtonIcon" parent="KeyboardButtonFunctional">
        <item name="android:layout_weight">1.3</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawableTint">@color/kb_icon_dark</item>
    </style>

    <style name="KeyboardButtonShift" parent="KeyboardButtonIcon">
        <item name="android:layout_weight">1.15</item>
        <item name="android:drawableTint">@null</item>
    </style>

    <style name="KeyboardButtonSpace" parent="KeyboardButton">
        <item name="android:layout_weight">3.4</item>
        <item name="android:background">@drawable/key_background_space_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/kb_text_functional_dark</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="KeyboardButtonEnter" parent="KeyboardButton">
        <item name="android:layout_weight">1.4</item>
        <item name="android:background">@drawable/key_background_enter</item>
        <item name="android:textColor">@color/kb_enter_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawableTint">@color/kb_enter_text</item>
    </style>

    <style name="KeyboardButtonBottomSmall" parent="KeyboardButtonFunctional">
        <item name="android:layout_weight">1.35</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="KeyboardButtonLanguage" parent="KeyboardButtonFunctional">
        <item name="android:layout_weight">1.05</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="KeyboardButtonMic" parent="KeyboardButtonFunctional">
        <item name="android:layout_weight">0.9</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawableTint">@color/kb_icon_dark</item>
    </style>

    <style name="KeyboardButtonWide" parent="KeyboardButton">
        <item name="android:layout_weight">1.5</item>
    </style>
    <style name="KeyboardButtonBottomSpace" parent="KeyboardButtonSpace" />
    <style name="KeyboardButtonBottomEnter" parent="KeyboardButtonEnter" />
</resources>
