<?xml version="1.0" encoding="utf-8"?>
<!-- Emoji Keyboard — dark mode using native AndroidX Jetpack EmojiPickerView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg_dark"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:layoutDirection="ltr">

    <!-- Native EmojiPickerView from androidx.emoji2:emoji2-emojipicker library -->
    <androidx.emoji2.emojipicker.EmojiPickerView
        android:id="@+id/emoji_picker_view"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        app:emojiGridColumns="8" />

    <!-- Bottom Actions Bar: ABC | Search Emoji Pill | ⌫ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <!-- ABC / Back to keyboard -->
        <Button
            android:id="@+id/emoji_key_abc"
            style="@style/KeyboardButtonFunctional"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="ABC"
            android:textSize="13sp" />

        <!-- Gboard-Style Search Emoji Pill -->
        <LinearLayout
            android:id="@+id/emoji_search_pill"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/emoji_search_bg_dark"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search_dark"
                android:contentDescription="Search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Search emoji"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Backspace (remove) -->
        <Button
            android:id="@+id/emoji_key_backspace"
            style="@style/KeyboardButtonIcon"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text=""
            android:drawableTop="@drawable/ic_backspace_dark"
            android:drawablePadding="0dp" />
    </LinearLayout>

</LinearLayout>
