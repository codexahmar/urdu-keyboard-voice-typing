<?xml version="1.0" encoding="utf-8"?>
<!-- Emoji Keyboard — dark mode with embedded fast emoji search and native Jetpack EmojiPickerView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg_dark"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:layoutDirection="ltr">

    <!-- ── ROW 1: Search Emoji Bar ── -->
    <LinearLayout
        android:id="@+id/emoji_search_pill"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/emoji_search_bg_dark"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search_dark"
            android:contentDescription="Search" />

        <TextView
            android:id="@+id/emoji_search_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Search emoji"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:singleLine="true"
            android:fontFamily="sans-serif" />

        <!-- Clear Search Button [✕] -->
        <Button
            android:id="@+id/emoji_search_clear_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@android:color/transparent"
            android:text="✕"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ── ROW 2: Horizontal Quick Search Filter Chips ── -->
    <HorizontalScrollView
        android:id="@+id/emoji_search_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginBottom="3dp">

        <LinearLayout
            android:id="@+id/emoji_search_chips_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- ── ROW 3: Emoji Display Container (Full Picker or Filtered Grid) ── -->
    <FrameLayout
        android:id="@+id/emoji_display_container"
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <!-- Default: Native AndroidX EmojiPickerView -->
        <androidx.emoji2.emojipicker.EmojiPickerView
            android:id="@+id/emoji_picker_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:emojiGridColumns="8" />

        <!-- Filtered Emoji Search Results Grid -->
        <ScrollView
            android:id="@+id/emoji_search_grid_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/emoji_search_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="8"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />
        </ScrollView>
    </FrameLayout>

    <!-- ── ROW 4: Bottom Bar: ABC (Left) | Spacer | ⌫ Backspace (Right) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <!-- ABC / Back to keyboard -->
        <Button
            android:id="@+id/emoji_key_abc"
            style="@style/KeyboardButtonFunctional"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:text="ABC"
            android:textSize="13sp" />

        <!-- Spacer pushing ABC to far left and Backspace to far right -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Backspace (remove) -->
        <Button
            android:id="@+id/emoji_key_backspace"
            style="@style/KeyboardButtonIcon"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:text=""
            android:drawableTop="@drawable/ic_backspace_dark"
            android:drawablePadding="0dp" />
    </LinearLayout>

</LinearLayout>
