<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode Urdu keyboard — identical structure, dark colors auto-applied via values-night -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg_dark"
    android:clipToPadding="false"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp">

    <!-- ── ROW 0 : Suggestions strip ──────────────────────────── -->
    <LinearLayout
        android:id="@+id/suggestions_strip"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <Button
            android:id="@+id/suggestion_left"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#1AFFFFFF" />

        <Button
            android:id="@+id/suggestion_center"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#1AFFFFFF" />

        <Button
            android:id="@+id/suggestion_right"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#1AFFFFFF" />

        <Button
            android:id="@+id/urdu_key_voice"
            style="@style/KeyboardButtonIcon"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:text=""
            android:drawableTop="@drawable/ic_mic_dark"
            android:drawablePadding="0dp" />
    </LinearLayout>

    <!-- ── ROW 1 : ض ص ث ق ف غ ع ہ خ ح ──────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/urdu_key_1"  style="@style/KeyboardButtonUrdu" android:text="ض" />
        <Button android:id="@+id/urdu_key_2"  style="@style/KeyboardButtonUrdu" android:text="ص" />
        <Button android:id="@+id/urdu_key_3"  style="@style/KeyboardButtonUrdu" android:text="ث" />
        <Button android:id="@+id/urdu_key_4"  style="@style/KeyboardButtonUrdu" android:text="ق" />
        <Button android:id="@+id/urdu_key_5"  style="@style/KeyboardButtonUrdu" android:text="ف" />
        <Button android:id="@+id/urdu_key_6"  style="@style/KeyboardButtonUrdu" android:text="غ" />
        <Button android:id="@+id/urdu_key_7"  style="@style/KeyboardButtonUrdu" android:text="ع" />
        <Button android:id="@+id/urdu_key_8"  style="@style/KeyboardButtonUrdu" android:text="ہ" />
        <Button android:id="@+id/urdu_key_9"  style="@style/KeyboardButtonUrdu" android:text="خ" />
        <Button android:id="@+id/urdu_key_10" style="@style/KeyboardButtonUrdu" android:text="ح" />
    </LinearLayout>

    <!-- ── ROW 2 : ج چ ظ ط ز ر ڑ د ڈ ب ────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/urdu_key_11" style="@style/KeyboardButtonUrdu" android:text="ج" />
        <Button android:id="@+id/urdu_key_12" style="@style/KeyboardButtonUrdu" android:text="چ" />
        <Button android:id="@+id/urdu_key_13" style="@style/KeyboardButtonUrdu" android:text="ظ" />
        <Button android:id="@+id/urdu_key_14" style="@style/KeyboardButtonUrdu" android:text="ط" />
        <Button android:id="@+id/urdu_key_15" style="@style/KeyboardButtonUrdu" android:text="ز" />
        <Button android:id="@+id/urdu_key_16" style="@style/KeyboardButtonUrdu" android:text="ر" />
        <Button android:id="@+id/urdu_key_17" style="@style/KeyboardButtonUrdu" android:text="ڑ" />
        <Button android:id="@+id/urdu_key_18" style="@style/KeyboardButtonUrdu" android:text="د" />
        <Button android:id="@+id/urdu_key_19" style="@style/KeyboardButtonUrdu" android:text="ڈ" />
        <Button android:id="@+id/urdu_key_20" style="@style/KeyboardButtonUrdu" android:text="ب" />
    </LinearLayout>

    <!-- ── ROW 3 : پ ت ٹ ش س ک گ ل م ن ─────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/urdu_key_21" style="@style/KeyboardButtonUrdu" android:text="پ" />
        <Button android:id="@+id/urdu_key_22" style="@style/KeyboardButtonUrdu" android:text="ت" />
        <Button android:id="@+id/urdu_key_23" style="@style/KeyboardButtonUrdu" android:text="ٹ" />
        <Button android:id="@+id/urdu_key_24" style="@style/KeyboardButtonUrdu" android:text="ش" />
        <Button android:id="@+id/urdu_key_25" style="@style/KeyboardButtonUrdu" android:text="س" />
        <Button android:id="@+id/urdu_key_26" style="@style/KeyboardButtonUrdu" android:text="ک" />
        <Button android:id="@+id/urdu_key_27" style="@style/KeyboardButtonUrdu" android:text="گ" />
        <Button android:id="@+id/urdu_key_28" style="@style/KeyboardButtonUrdu" android:text="ل" />
        <Button android:id="@+id/urdu_key_29" style="@style/KeyboardButtonUrdu" android:text="م" />
        <Button android:id="@+id/urdu_key_30" style="@style/KeyboardButtonUrdu" android:text="ن" />
    </LinearLayout>

    <!-- ── ROW 4 : [⇧] و ے ی ں ھ ا آ ء [⌫] ──────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/urdu_key_shift"
            style="@style/KeyboardButtonShift"
            android:text=""
            android:drawableTop="@drawable/ic_shift_dark"
            android:drawablePadding="0dp" />

        <Button android:id="@+id/urdu_key_31" style="@style/KeyboardButtonUrdu" android:layout_weight="0.925" android:text="و" />
        <Button android:id="@+id/urdu_key_32" style="@style/KeyboardButtonUrdu" android:layout_weight="0.925" android:text="ے" />
        <Button android:id="@+id/urdu_key_33" style="@style/KeyboardButtonUrdu" android:layout_weight="0.925" android:text="ی" />
        <Button android:id="@+id/urdu_key_34" style="@style/KeyboardButtonUrdu" android:layout_weight="0.925" android:text="ں" />
        <Button android:id="@+id/urdu_key_35" style="@style/KeyboardButtonUrdu" android:layout_weight="0.925" android:text="ھ" />
        <Button android:id="@+id/urdu_key_36" style="@style/KeyboardButtonUrdu" android:layout_weight="0.925" android:text="ا" />
        <Button android:id="@+id/urdu_key_37" style="@style/KeyboardButtonUrdu" android:layout_weight="0.925" android:text="آ" />
        <Button android:id="@+id/urdu_key_38" style="@style/KeyboardButtonUrdu" android:layout_weight="0.925" android:text="ء" />

        <Button
            android:id="@+id/urdu_backspace"
            style="@style/KeyboardButtonIcon"
            android:text=""
            android:drawableTop="@drawable/ic_backspace_dark"
            android:drawablePadding="0dp" />
    </LinearLayout>

    <!-- ── ROW 5 (bottom) : [؟۱۲۳] [اردو] [،] [Space] [۔] [Emoji] [↵] ──────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:paddingBottom="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/urdu_key_symbols"
            style="@style/KeyboardButtonBottomSmall"
            android:text="؟۱۲۳" />

        <Button
            android:id="@+id/urdu_key_language"
            style="@style/KeyboardButtonLanguage"
            android:text="اردو" />

        <Button
            android:id="@+id/urdu_key_comma"
            style="@style/KeyboardButtonFunctional"
            android:layout_weight="0.8"
            android:text="،" />

        <Button
            android:id="@+id/urdu_key_space"
            style="@style/KeyboardButtonSpace"
            android:text="اردو" />

        <Button
            android:id="@+id/urdu_key_dot"
            style="@style/KeyboardButtonFunctional"
            android:layout_weight="0.8"
            android:text="۔" />

        <Button
            android:id="@+id/urdu_key_emoji"
            style="@style/KeyboardButtonIcon"
            android:text=""
            android:drawableTop="@drawable/ic_emoji_dark"
            android:drawablePadding="0dp" />

        <Button
            android:id="@+id/urdu_key_enter"
            style="@style/KeyboardButtonEnter"
            android:text=""
            android:drawableTop="@drawable/ic_enter"
            android:drawablePadding="0dp" />
    </LinearLayout>

</LinearLayout>
