<?xml version="1.0" encoding="utf-8"?>
<!--
  Urdu Keyboard (Dark) — Exact Gboard Layout (Official Android Pakistan Standard)
  Reverse-engineered from Google Gboard (com.google.android.inputmethod.latin)

  Row 1 (10 keys): ض ص غ ڑ ٹ ث ح ئ ظ ط
  Row 2 (10 keys): ق و ع ر ت ے ء ی ہ پ   (Long-press: و→ؤ, ے→ۓ, ء→ٔ, ہ→ۂ/ۃ)
  Row 3 (10 keys): ا س ڈ د ف گ ھ ج ک ل   (Long-press: ا→آ/أ)
  Row 4 (10 keys): ذ ز ش خ چ ب ں ن م [⌫] (Long-press: ز→ژ, م→؟)
  Row 5 (bottom) : [؟۱۲۳] [EN] [،] [ Space: اردو ] [۔] [😊] [↵]

  Layout direction is fixed LTR so physical touch positioning matches Gboard muscle memory.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg_dark"
    android:clipToPadding="false"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:splitMotionEvents="true"
    android:paddingStart="3dp"
    android:paddingEnd="3dp"
    android:paddingTop="3dp">

    <!-- ── ROW 0A : Suggestions strip (Normal Typing Mode) ──────── -->
    <LinearLayout
        android:id="@+id/suggestions_strip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="visible">

        <Button
            android:id="@+id/suggestion_left"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#26FFFFFF" />

        <Button
            android:id="@+id/suggestion_center"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#26FFFFFF" />

        <Button
            android:id="@+id/suggestion_right"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#26FFFFFF" />

        <Button
            android:id="@+id/key_voice"
            style="@style/KeyboardButtonIcon"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:text=""
            android:drawableTop="@drawable/ic_mic_dark"
            android:drawablePadding="0dp" />
    </LinearLayout>

    <!-- ── ROW 0B : Emoji Live Search Header (Gboard Style - Dark) ─ -->
    <LinearLayout
        android:id="@+id/emoji_search_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <!-- Back to Full Emoji Picker -->
        <ImageButton
            android:id="@+id/btn_emoji_search_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_dark"
            android:scaleType="centerInside"
            android:contentDescription="Back" />

        <!-- Query input capsule -->
        <LinearLayout
            android:id="@+id/emoji_search_query_box"
            android:layout_width="125dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/emoji_search_bg_dark"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_search_dark"
                android:contentDescription="Search" />

            <TextView
                android:id="@+id/tv_emoji_search_query"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text=""
                android:hint="Search"
                android:textColor="@color/kb_text_primary_dark"
                android:textColorHint="#AFAFB3"
                android:textSize="13sp"
                android:singleLine="true" />

            <!-- Blinking cursor matching Gboard -->
            <View
                android:id="@+id/emoji_search_cursor"
                android:layout_width="1.5dp"
                android:layout_height="16dp"
                android:layout_marginStart="1dp"
                android:background="#1A73E8"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_emoji_search_clear"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@android:color/transparent"
                android:text="✕"
                android:textSize="11sp"
                android:textColor="#AFAFB3"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Live matching emojis horizontal scroll (Gboard strip) -->
        <HorizontalScrollView
            android:id="@+id/emoji_search_results_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/emoji_search_results_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ── ROW 1 : 10 keys (ض ص غ ڑ ٹ ث ح ئ ظ ط) ─────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:orientation="horizontal">

        <Button android:id="@+id/urdu_key_1" style="@style/KeyboardButtonUrdu" android:text="ض" />
        <Button android:id="@+id/urdu_key_2" style="@style/KeyboardButtonUrdu" android:text="ص" />
        <Button android:id="@+id/urdu_key_3" style="@style/KeyboardButtonUrdu" android:text="غ" />
        <Button android:id="@+id/urdu_key_4" style="@style/KeyboardButtonUrdu" android:text="ڑ" />
        <Button android:id="@+id/urdu_key_5" style="@style/KeyboardButtonUrdu" android:text="ٹ" />
        <Button android:id="@+id/urdu_key_6" style="@style/KeyboardButtonUrdu" android:text="ث" />
        <Button android:id="@+id/urdu_key_7" style="@style/KeyboardButtonUrdu" android:text="ح" />
        <Button android:id="@+id/urdu_key_8" style="@style/KeyboardButtonUrdu" android:text="ئ" />
        <Button android:id="@+id/urdu_key_9" style="@style/KeyboardButtonUrdu" android:text="ظ" />
        <Button android:id="@+id/urdu_key_10" style="@style/KeyboardButtonUrdu" android:text="ط" />
    </LinearLayout>

    <!-- ── ROW 2 : 10 keys (ق و ع ر ت ے ء ی ہ پ) ─────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:orientation="horizontal">

        <Button android:id="@+id/urdu_key_11" style="@style/KeyboardButtonUrdu" android:text="ق" />
        <Button android:id="@+id/urdu_key_12" style="@style/KeyboardButtonUrdu" android:text="و" />
        <Button android:id="@+id/urdu_key_13" style="@style/KeyboardButtonUrdu" android:text="ع" />
        <Button android:id="@+id/urdu_key_14" style="@style/KeyboardButtonUrdu" android:text="ر" />
        <Button android:id="@+id/urdu_key_15" style="@style/KeyboardButtonUrdu" android:text="ت" />
        <Button android:id="@+id/urdu_key_16" style="@style/KeyboardButtonUrdu" android:text="ے" />
        <Button android:id="@+id/urdu_key_17" style="@style/KeyboardButtonUrdu" android:text="ء" />
        <Button android:id="@+id/urdu_key_18" style="@style/KeyboardButtonUrdu" android:text="ی" />
        <Button android:id="@+id/urdu_key_19" style="@style/KeyboardButtonUrdu" android:text="ہ" />
        <Button android:id="@+id/urdu_key_20" style="@style/KeyboardButtonUrdu" android:text="پ" />
    </LinearLayout>

    <!-- ── ROW 3 : 10 keys (ا س ڈ د ف گ ھ ج ک ل) ─────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:orientation="horizontal">

        <Button android:id="@+id/urdu_key_21" style="@style/KeyboardButtonUrdu" android:text="ا" />
        <Button android:id="@+id/urdu_key_22" style="@style/KeyboardButtonUrdu" android:text="س" />
        <Button android:id="@+id/urdu_key_23" style="@style/KeyboardButtonUrdu" android:text="ڈ" />
        <Button android:id="@+id/urdu_key_24" style="@style/KeyboardButtonUrdu" android:text="د" />
        <Button android:id="@+id/urdu_key_25" style="@style/KeyboardButtonUrdu" android:text="ف" />
        <Button android:id="@+id/urdu_key_26" style="@style/KeyboardButtonUrdu" android:text="گ" />
        <Button android:id="@+id/urdu_key_27" style="@style/KeyboardButtonUrdu" android:text="ھ" />
        <Button android:id="@+id/urdu_key_28" style="@style/KeyboardButtonUrdu" android:text="ج" />
        <Button android:id="@+id/urdu_key_29" style="@style/KeyboardButtonUrdu" android:text="ک" />
        <Button android:id="@+id/urdu_key_30" style="@style/KeyboardButtonUrdu" android:text="ل" />
    </LinearLayout>

    <!-- ── ROW 4 : 10 keys (ذ ز ش خ چ ب ں ن م + ⌫) ────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:orientation="horizontal">

        <Button android:id="@+id/urdu_key_31" style="@style/KeyboardButtonUrdu" android:text="ذ" />
        <Button android:id="@+id/urdu_key_32" style="@style/KeyboardButtonUrdu" android:text="ز" />
        <Button android:id="@+id/urdu_key_33" style="@style/KeyboardButtonUrdu" android:text="ش" />
        <Button android:id="@+id/urdu_key_34" style="@style/KeyboardButtonUrdu" android:text="خ" />
        <Button android:id="@+id/urdu_key_35" style="@style/KeyboardButtonUrdu" android:text="چ" />
        <Button android:id="@+id/urdu_key_36" style="@style/KeyboardButtonUrdu" android:text="ب" />
        <Button android:id="@+id/urdu_key_37" style="@style/KeyboardButtonUrdu" android:text="ں" />
        <Button android:id="@+id/urdu_key_38" style="@style/KeyboardButtonUrdu" android:text="ن" />
        <Button android:id="@+id/urdu_key_39" style="@style/KeyboardButtonUrdu" android:text="م" />

        <Button
            android:id="@+id/urdu_key_backspace"
            style="@style/KeyboardButtonIcon"
            android:layout_weight="1"
            android:text=""
            android:drawableTop="@drawable/ic_backspace_dark"
            android:drawablePadding="0dp" />
    </LinearLayout>

    <!-- ── ROW 5 : Bottom Row (7 keys — Exact Gboard Proportions) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:paddingBottom="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/urdu_key_symbols"
            style="@style/KeyboardButtonBottomSmall"
            android:layout_weight="1.5"
            android:text="؟۱۲۳" />

        <Button
            android:id="@+id/urdu_key_language"
            style="@style/KeyboardButtonLanguage"
            android:layout_weight="1.0"
            android:text="EN" />

        <Button
            android:id="@+id/urdu_key_comma"
            style="@style/KeyboardButtonFunctional"
            android:layout_weight="1.0"
            android:text="،" />

        <Button
            android:id="@+id/urdu_key_space"
            style="@style/KeyboardButtonSpace"
            android:layout_weight="3.0"
            android:text="اردو" />

        <Button
            android:id="@+id/urdu_key_dot"
            style="@style/KeyboardButtonFunctional"
            android:layout_weight="1.0"
            android:text="۔" />

        <Button
            android:id="@+id/urdu_key_emoji"
            style="@style/KeyboardButtonIcon"
            android:layout_weight="1.0"
            android:text=""
            android:drawableTop="@drawable/ic_emoji_dark"
            android:drawablePadding="0dp" />

        <Button
            android:id="@+id/urdu_key_enter"
            style="@style/KeyboardButtonEnter"
            android:layout_weight="1.5"
            android:text=""
            android:drawableTop="@drawable/ic_enter"
            android:drawablePadding="0dp" />
    </LinearLayout>

</LinearLayout>
