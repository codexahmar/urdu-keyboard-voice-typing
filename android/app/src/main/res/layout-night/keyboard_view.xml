<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: identical to layout/keyboard_view.xml — styles auto-switch via values-night -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg_dark"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:splitMotionEvents="true"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp">

    <!-- ── ROW 0 : Suggestions strip ──────────────────────────── -->
    <LinearLayout
        android:id="@+id/suggestions_strip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <Button
            android:id="@+id/suggestion_left"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#26FFFFFF" />

        <Button
            android:id="@+id/suggestion_center"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#26FFFFFF" />

        <Button
            android:id="@+id/suggestion_right"
            style="@style/SuggestionButton"
            android:text="" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#26FFFFFF" />

        <Button
            android:id="@+id/key_voice"
            style="@style/KeyboardButtonIcon"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:text=""
            android:drawableTop="@drawable/ic_mic_dark"
            android:drawablePadding="0dp" />
    </LinearLayout>

    <!-- ── ROW 0B : Emoji Live Search Header (Gboard Style - Dark) ─ -->
    <LinearLayout
        android:id="@+id/emoji_search_header"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <!-- Back to Full Emoji Picker -->
        <ImageButton
            android:id="@+id/btn_emoji_search_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_dark"
            android:scaleType="centerInside"
            android:contentDescription="Back" />

        <!-- Query input capsule -->
        <LinearLayout
            android:id="@+id/emoji_search_query_box"
            android:layout_width="125dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/emoji_search_bg_dark"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_search_dark"
                android:contentDescription="Search" />

            <TextView
                android:id="@+id/tv_emoji_search_query"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text=""
                android:hint="Search"
                android:textColor="@color/kb_text_primary_dark"
                android:textColorHint="#AFAFB3"
                android:textSize="13sp"
                android:singleLine="true" />

            <!-- Blinking cursor matching Gboard -->
            <View
                android:id="@+id/emoji_search_cursor"
                android:layout_width="1.5dp"
                android:layout_height="16dp"
                android:layout_marginStart="1dp"
                android:background="#1A73E8"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_emoji_search_clear"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@android:color/transparent"
                android:text="✕"
                android:textSize="11sp"
                android:textColor="#AFAFB3"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Live matching emojis horizontal scroll (Gboard strip) -->
        <HorizontalScrollView
            android:id="@+id/emoji_search_results_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/emoji_search_results_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:orientation="horizontal">
        <Button android:id="@+id/key_q" style="@style/KeyboardButton" android:text="q" />
        <Button android:id="@+id/key_w" style="@style/KeyboardButton" android:text="w" />
        <Button android:id="@+id/key_e" style="@style/KeyboardButton" android:text="e" />
        <Button android:id="@+id/key_r" style="@style/KeyboardButton" android:text="r" />
        <Button android:id="@+id/key_t" style="@style/KeyboardButton" android:text="t" />
        <Button android:id="@+id/key_y" style="@style/KeyboardButton" android:text="y" />
        <Button android:id="@+id/key_u" style="@style/KeyboardButton" android:text="u" />
        <Button android:id="@+id/key_i" style="@style/KeyboardButton" android:text="i" />
        <Button android:id="@+id/key_o" style="@style/KeyboardButton" android:text="o" />
        <Button android:id="@+id/key_p" style="@style/KeyboardButton" android:text="p" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:orientation="horizontal">
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
        <Button android:id="@+id/key_a" style="@style/KeyboardButton" android:text="a" />
        <Button android:id="@+id/key_s" style="@style/KeyboardButton" android:text="s" />
        <Button android:id="@+id/key_d" style="@style/KeyboardButton" android:text="d" />
        <Button android:id="@+id/key_f" style="@style/KeyboardButton" android:text="f" />
        <Button android:id="@+id/key_g" style="@style/KeyboardButton" android:text="g" />
        <Button android:id="@+id/key_h" style="@style/KeyboardButton" android:text="h" />
        <Button android:id="@+id/key_j" style="@style/KeyboardButton" android:text="j" />
        <Button android:id="@+id/key_k" style="@style/KeyboardButton" android:text="k" />
        <Button android:id="@+id/key_l" style="@style/KeyboardButton" android:text="l" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:layout_marginBottom="3dp"
        android:orientation="horizontal">
        <Button android:id="@+id/key_shift" style="@style/KeyboardButtonShift" android:layout_weight="1.5" android:text="" android:drawableTop="@drawable/ic_shift_dark" android:drawablePadding="0dp" />
        <Button android:id="@+id/key_z" style="@style/KeyboardButton" android:text="z" />
        <Button android:id="@+id/key_x" style="@style/KeyboardButton" android:text="x" />
        <Button android:id="@+id/key_c" style="@style/KeyboardButton" android:text="c" />
        <Button android:id="@+id/key_v" style="@style/KeyboardButton" android:text="v" />
        <Button android:id="@+id/key_b" style="@style/KeyboardButton" android:text="b" />
        <Button android:id="@+id/key_n" style="@style/KeyboardButton" android:text="n" />
        <Button android:id="@+id/key_m" style="@style/KeyboardButton" android:text="m" />
        <Button android:id="@+id/key_backspace" style="@style/KeyboardButtonIcon" android:layout_weight="1.5" android:text="" android:drawableTop="@drawable/ic_backspace_dark" android:drawablePadding="0dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:splitMotionEvents="true"
        android:paddingBottom="2dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/key_symbols"
            style="@style/KeyboardButtonBottomSmall"
            android:layout_weight="1.5"
            android:text="\?123" />

        <Button
            android:id="@+id/key_language"
            style="@style/KeyboardButtonLanguage"
            android:layout_weight="1.0"
            android:text="اردو" />

        <Button
            android:id="@+id/key_comma"
            style="@style/KeyboardButtonFunctional"
            android:layout_weight="1.0"
            android:text="," />

        <Button
            android:id="@+id/key_space"
            style="@style/KeyboardButtonSpace"
            android:layout_weight="3.0"
            android:text="English" />

        <Button
            android:id="@+id/key_dot"
            style="@style/KeyboardButtonFunctional"
            android:layout_weight="1.0"
            android:text="." />

        <Button
            android:id="@+id/key_emoji"
            style="@style/KeyboardButtonIcon"
            android:layout_weight="1.0"
            android:text=""
            android:drawableTop="@drawable/ic_emoji_dark"
            android:drawablePadding="0dp" />

        <Button
            android:id="@+id/key_enter"
            style="@style/KeyboardButtonEnter"
            android:layout_weight="1.5"
            android:text=""
            android:drawableTop="@drawable/ic_enter"
            android:drawablePadding="0dp" />
    </LinearLayout>

</LinearLayout>
