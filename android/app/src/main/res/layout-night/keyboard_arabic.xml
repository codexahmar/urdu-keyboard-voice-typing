<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1C1E"
    android:padding="4dp">

    <!-- First Row: Arabic letters (ض to ج) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/arabic_key_1"
            style="@style/KeyboardButton"
            android:text="ض" />

        <Button
            android:id="@+id/arabic_key_2"
            style="@style/KeyboardButton"
            android:text="ص" />

        <Button
            android:id="@+id/arabic_key_3"
            style="@style/KeyboardButton"
            android:text="ث" />

        <Button
            android:id="@+id/arabic_key_4"
            style="@style/KeyboardButton"
            android:text="ق" />

        <Button
            android:id="@+id/arabic_key_5"
            style="@style/KeyboardButton"
            android:text="ف" />

        <Button
            android:id="@+id/arabic_key_6"
            style="@style/KeyboardButton"
            android:text="غ" />

        <Button
            android:id="@+id/arabic_key_7"
            style="@style/KeyboardButton"
            android:text="ع" />

        <Button
            android:id="@+id/arabic_key_8"
            style="@style/KeyboardButton"
            android:text="ه" />

        <Button
            android:id="@+id/arabic_key_9"
            style="@style/KeyboardButton"
            android:text="خ" />

        <Button
            android:id="@+id/arabic_key_10"
            style="@style/KeyboardButton"
            android:text="ح" />

        <Button
            android:id="@+id/arabic_key_11"
            style="@style/KeyboardButton"
            android:text="ج" />
    </LinearLayout>

    <!-- Second Row: Arabic letters (ش to ك) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/arabic_key_12"
            style="@style/KeyboardButton"
            android:text="ش" />

        <Button
            android:id="@+id/arabic_key_13"
            style="@style/KeyboardButton"
            android:text="س" />

        <Button
            android:id="@+id/arabic_key_14"
            style="@style/KeyboardButton"
            android:text="ي" />

        <Button
            android:id="@+id/arabic_key_15"
            style="@style/KeyboardButton"
            android:text="ب" />

        <Button
            android:id="@+id/arabic_key_16"
            style="@style/KeyboardButton"
            android:text="ل" />

        <Button
            android:id="@+id/arabic_key_17"
            style="@style/KeyboardButton"
            android:text="ا" />

        <Button
            android:id="@+id/arabic_key_18"
            style="@style/KeyboardButton"
            android:text="ت" />

        <Button
            android:id="@+id/arabic_key_19"
            style="@style/KeyboardButton"
            android:text="ن" />

        <Button
            android:id="@+id/arabic_key_20"
            style="@style/KeyboardButton"
            android:text="م" />

        <Button
            android:id="@+id/arabic_key_21"
            style="@style/KeyboardButton"
            android:text="ك" />
    </LinearLayout>

    <!-- Third Row: Arabic letters + Backspace (ظ to و) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/arabic_key_22"
            style="@style/KeyboardButton"
            android:text="ظ" />

        <Button
            android:id="@+id/arabic_key_23"
            style="@style/KeyboardButton"
            android:text="ط" />

        <Button
            android:id="@+id/arabic_key_24"
            style="@style/KeyboardButton"
            android:text="ذ" />

        <Button
            android:id="@+id/arabic_key_25"
            style="@style/KeyboardButton"
            android:text="د" />

        <Button
            android:id="@+id/arabic_key_26"
            style="@style/KeyboardButton"
            android:text="ز" />

        <Button
            android:id="@+id/arabic_key_27"
            style="@style/KeyboardButton"
            android:text="ر" />

        <Button
            android:id="@+id/arabic_key_28"
            style="@style/KeyboardButton"
            android:text="و" />

        <Button
            android:id="@+id/arabic_backspace"
            style="@style/KeyboardButtonWide"
            android:text="⌫"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Fourth Row: Special Arabic characters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/arabic_key_29"
            style="@style/KeyboardButton"
            android:text="ئ" />

        <Button
            android:id="@+id/arabic_key_30"
            style="@style/KeyboardButton"
            android:text="ء" />

        <Button
            android:id="@+id/arabic_key_31"
            style="@style/KeyboardButton"
            android:text="ؤ" />

        <Button
            android:id="@+id/arabic_key_32"
            style="@style/KeyboardButton"
            android:text="ة" />

        <Button
            android:id="@+id/arabic_key_33"
            style="@style/KeyboardButton"
            android:text="ى" />

        <Button
            android:id="@+id/arabic_key_34"
            style="@style/KeyboardButton"
            android:text="لا" />

        <Button
            android:id="@+id/arabic_key_35"
            style="@style/KeyboardButton"
            android:text="آ" />
    </LinearLayout>

    <!-- Fifth Row: Language, Voice, Space, Enter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/arabic_key_language"
            style="@style/KeyboardButtonWide"
            android:text="عربي"
            android:textSize="14sp" />

        <Button
            android:id="@+id/arabic_key_voice"
            style="@style/KeyboardButtonWide"
            android:text="🎤"
            android:textSize="18sp" />

        <Button
            android:id="@+id/arabic_key_space"
            style="@style/KeyboardButtonSpace"
            android:text="Space" />

        <Button
            android:id="@+id/arabic_key_enter"
            style="@style/KeyboardButtonWide"
            android:text="↵"
            android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>
