<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- =====================================================================
         App / Window themes
         ===================================================================== -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Service theme for system keyboard window and EmojiPickerView -->
    <style name="KeyboardTheme" parent="@android:style/Theme.DeviceDefault.InputMethod">
        <item name="android:textColorPrimary">@color/kb_text_primary_light</item>
        <item name="android:textColorSecondary">@color/kb_text_functional_light</item>
        <item name="android:colorBackground">@color/kb_bg_light</item>
        <item name="android:windowBackground">@color/kb_bg_light</item>
    </style>

    <!-- =====================================================================
         BASE: KeyboardButton
         All key styles inherit from this. Matches Google Gboard standards.
         ===================================================================== -->
    <style name="KeyboardButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <!-- Soft 3D bevel ripple background from drawable -->
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textColor">@color/kb_text_primary_light</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <!-- Suppress default Button ripple/elevation animation -->
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Urdu letter keys — 23sp font size for Persio-Arabic script legibility -->
    <style name="KeyboardButtonUrdu" parent="KeyboardButton">
        <item name="android:textSize">23sp</item>
    </style>

    <!-- =====================================================================
         FUNCTIONAL keys: Shift, Backspace, 123, Language
         Visually distinct from character keys (Gboard soft slate-gray)
         ===================================================================== -->
    <style name="KeyboardButtonFunctional" parent="KeyboardButton">
        <item name="android:background">@drawable/key_background_functional</item>
        <item name="android:textColor">@color/kb_text_functional_light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- =====================================================================
         ICON-ONLY functional: Shift, Backspace (no text, just drawable)
         Set android:text="" in XML and use android:drawableTop
         ===================================================================== -->
    <style name="KeyboardButtonIcon" parent="KeyboardButtonFunctional">
        <item name="android:layout_weight">1.3</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">0sp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawableTint">@color/kb_icon_light</item>
    </style>

    <!-- Shift uses state-specific vector colors, so we do not force icon tint. -->
    <style name="KeyboardButtonShift" parent="KeyboardButtonIcon">
        <item name="android:layout_weight">1.3</item>
        <item name="android:drawableTint">@null</item>
    </style>

    <!-- =====================================================================
         SPACE bar: wider pill shape (Gboard standard)
         ===================================================================== -->
    <style name="KeyboardButtonSpace" parent="KeyboardButton">
        <item name="android:layout_weight">3.8</item>
        <item name="android:background">@drawable/key_background_space</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/kb_text_functional_light</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- =====================================================================
         ENTER key: Google Blue accent (Gboard standard)
         ===================================================================== -->
    <style name="KeyboardButtonEnter" parent="KeyboardButton">
        <item name="android:layout_weight">1.3</item>
        <item name="android:background">@drawable/key_background_enter</item>
        <item name="android:textColor">@color/kb_enter_text</item>
        <item name="android:textSize">0sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawableTint">@color/kb_enter_text</item>
    </style>

    <!-- =====================================================================
         BOTTOM-ROW utility keys: 123, Language, Mic
         ===================================================================== -->
    <style name="KeyboardButtonBottomSmall" parent="KeyboardButtonFunctional">
        <item name="android:layout_weight">1.3</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Language key: same as bottom small but labeled -->
    <style name="KeyboardButtonLanguage" parent="KeyboardButtonFunctional">
        <item name="android:layout_weight">1.0</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Mic key: icon only -->
    <style name="KeyboardButtonMic" parent="KeyboardButtonFunctional">
        <item name="android:layout_weight">0.9</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">0sp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawableTint">@color/kb_icon_light</item>
    </style>

    <!-- =====================================================================
         LEGACY aliases — kept so old XML references compile
         ===================================================================== -->
    <style name="KeyboardButtonWide" parent="KeyboardButton">
        <item name="android:layout_weight">1.5</item>
    </style>
    <style name="KeyboardButtonBottomSpace" parent="KeyboardButtonSpace" />
    <style name="KeyboardButtonBottomEnter" parent="KeyboardButtonEnter" />

    <!-- =====================================================================
         SUGGESTIONS: Suggestion buttons
         ===================================================================== -->
    <style name="SuggestionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/kb_text_primary_light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
