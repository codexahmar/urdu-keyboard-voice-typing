<?xml version="1.0" encoding="utf-8"?>
<!-- Emoji Keyboard — light mode using native AndroidX Jetpack EmojiPickerView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg_light"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:layoutDirection="ltr">

    <!-- Native EmojiPickerView from androidx.emoji2:emoji2-emojipicker library -->
    <androidx.emoji2.emojipicker.EmojiPickerView
        android:id="@+id/emoji_picker_view"
        android:layout_width="match_parent"
        android:layout_height="216dp"
        app:emojiGridColumns="8" />

    <!-- Bottom Actions Bar: ABC | Space | ⌫ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <!-- ABC / Back to keyboard -->
        <Button
            android:id="@+id/emoji_key_abc"
            style="@style/KeyboardButtonBottomSmall"
            android:layout_width="0dp"
            android:layout_weight="1.35"
            android:layout_height="36dp"
            android:text="ABC"
            android:textSize="13sp" />

        <!-- Space bar -->
        <Button
            android:id="@+id/emoji_key_space"
            style="@style/KeyboardButtonSpace"
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="36dp"
            android:text="Space" />

        <!-- Backspace -->
        <Button
            android:id="@+id/emoji_key_backspace"
            style="@style/KeyboardButtonIcon"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text=""
            android:drawableTop="@drawable/ic_backspace"
            android:drawablePadding="0dp" />
    </LinearLayout>

</LinearLayout>
